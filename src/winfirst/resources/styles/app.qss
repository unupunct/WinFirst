/* WinFirst theme. Tokens are replaced at runtime from ui/theme.py. */
QMainWindow, QDialog {
    background: @BG@;
}
QWidget {
    color: @TEXT@;
    font-family: "Segoe UI", "Segoe UI Variable Text", sans-serif;
    font-size: 10pt;
}
QToolTip {
    background: @CARD@;
    color: @TEXT@;
    border: 1px solid @BORDER_STRONG@;
    padding: 5px 8px;
    border-radius: 4px;
}
QFrame#Sidebar {
    background: @SIDEBAR@;
    border-right: 1px solid @BORDER@;
}
QFrame#TopBar {
    background: @PANEL@;
    border-bottom: 1px solid @BORDER@;
}
QFrame#Card, QFrame#StatCard, QFrame#HeroCard {
    background: @CARD@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
}
QFrame#HeroCard {
    background: @CARD_ALT@;
    border: 1px solid @BORDER_STRONG@;
}
QFrame#Separator {
    background: @BORDER@;
    max-height: 1px;
    min-height: 1px;
    border: none;
}
QLabel {
    background: transparent;
}
QLabel#AppName {
    font-size: 19pt;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: @TEXT@;
}
QLabel#AppTagline, QLabel#Muted, QLabel#PageSubtitle {
    color: @MUTED@;
}
QLabel#PageTitle {
    font-size: 21pt;
    font-weight: 700;
    letter-spacing: -0.4px;
    color: @TEXT@;
}
QLabel#CardTitle {
    font-size: 11pt;
    font-weight: 600;
    color: @TEXT@;
}
QLabel#StatValue {
    font-size: 20pt;
    font-weight: 700;
    color: @TEXT@;
}
QLabel#StatCaption {
    color: @MUTED@;
    font-size: 9pt;
}
QLabel#SectionLabel {
    color: @FAINT@;
    font-size: 8.5pt;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#SmallMuted {
    color: @MUTED@;
    font-size: 9pt;
}
QLabel#ErrorText {
    color: @DANGER@;
}
QLabel#SuccessText {
    color: @SUCCESS@;
}
QLabel#Badge {
    border-radius: 9px;
    padding: 2px 9px;
    font-size: 8.5pt;
    font-weight: 600;
    background: @CARD_ALT@;
    color: @MUTED@;
    border: 1px solid @BORDER@;
}
QLabel#Badge[status="ok"] { color: @SUCCESS@; background: @SUCCESS_BG@; border-color: @SUCCESS@; }
QLabel#Badge[status="warning"] { color: @WARNING@; background: @WARNING_BG@; border-color: @WARNING@; }
QLabel#Badge[status="critical"] { color: @DANGER@; background: @DANGER_BG@; border-color: @DANGER@; }
QLabel#Badge[status="info"] { color: @ACCENT@; background: @INFO_BG@; border-color: @ACCENT@; }
QLabel#Badge[status="muted"] { color: @MUTED@; background: @CARD_ALT@; border-color: @BORDER@; }
QLabel#Banner {
    border-radius: 8px;
    padding: 10px 13px;
    background: @INFO_BG@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT@;
}
QLabel#Banner[level="warning"] { background: @WARNING_BG@; border-color: @WARNING@; }
QLabel#Banner[level="critical"] { background: @DANGER_BG@; border-color: @DANGER@; }
QLabel#Banner[level="success"] { background: @SUCCESS_BG@; border-color: @SUCCESS@; }
QPushButton {
    background: @CARD_ALT@;
    color: @TEXT@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 6px;
    padding: 6px 13px;
    min-height: 18px;
    font-weight: 500;
}
QPushButton:hover { background: @SIDEBAR_HOVER@; border-color: @ACCENT@; }
QPushButton:pressed { background: @SELECTION@; }
QPushButton:disabled { color: @DISABLED@; border-color: @BORDER@; background: @CARD@; }
QPushButton[variant="primary"] {
    background: @ACCENT@;
    border-color: @ACCENT@;
    color: #ffffff;
    font-weight: 600;
}
QPushButton[variant="primary"]:hover { background: @ACCENT_HOVER@; border-color: @ACCENT_HOVER@; }
QPushButton[variant="primary"]:pressed { background: @ACCENT_PRESSED@; }
QPushButton[variant="danger"] {
    background: @DANGER_BG@;
    border-color: @DANGER@;
    color: @DANGER@;
    font-weight: 600;
}
QPushButton[variant="danger"]:hover { background: @DANGER@; color: #ffffff; }
QPushButton[variant="ghost"] {
    background: transparent;
    border-color: transparent;
    color: @MUTED@;
}
QPushButton[variant="ghost"]:hover { background: @SIDEBAR_HOVER@; color: @TEXT@; }
QPushButton[variant="link"] {
    background: transparent;
    border: none;
    color: @ACCENT@;
    padding: 2px 4px;
    text-align: left;
}
QPushButton[variant="link"]:hover { color: @ACCENT_HOVER@; text-decoration: underline; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QDateTimeEdit {
    background: @INPUT@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 6px;
    padding: 6px 8px;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
    min-height: 18px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus, QDateTimeEdit:focus {
    border-color: @ACCENT@;
}
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled {
    color: @DISABLED@;
    background: @CARD@;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background: @CARD@;
    border: 1px solid @BORDER_STRONG@;
    selection-background-color: @SELECTION@;
    selection-color: @TEXT@;
    outline: 0;
}
QPlainTextEdit, QTextEdit, QTextBrowser {
    background: @INPUT@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: @ACCENT@;
    selection-color: #ffffff;
}
QPlainTextEdit#LogView {
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 9pt;
}
QCheckBox, QRadioButton {
    spacing: 7px;
    background: transparent;
}
QCheckBox:disabled { color: @DISABLED@; }
QGroupBox {
    border: 1px solid @BORDER@;
    border-radius: 8px;
    margin-top: 16px;
    padding-top: 12px;
    background: transparent;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: @MUTED@;
}
QTableWidget, QTableView, QTreeWidget, QTreeView, QListWidget {
    background: @CARD@;
    alternate-background-color: @CARD_ALT@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    gridline-color: @BORDER@;
    selection-background-color: @SELECTION@;
    selection-color: @TEXT@;
    outline: 0;
}
QTableWidget::item, QTreeWidget::item, QListWidget::item {
    padding: 5px 6px;
    border: none;
}
QTableWidget::item:selected, QTreeWidget::item:selected, QListWidget::item:selected {
    background: @SELECTION@;
    color: @TEXT@;
}
QHeaderView::section {
    background: @CARD_ALT@;
    color: @MUTED@;
    border: none;
    border-bottom: 1px solid @BORDER_STRONG@;
    border-right: 1px solid @BORDER@;
    padding: 7px 8px;
    font-weight: 600;
    font-size: 9pt;
}
QHeaderView::section:last { border-right: none; }
QTableCornerButton::section { background: @CARD_ALT@; border: none; }
QTreeWidget#NavTree {
    background: transparent;
    border: none;
    border-radius: 0;
    outline: 0;
    selection-background-color: transparent;
}
QTreeWidget#NavTree::item {
    height: 32px;
    padding: 3px 9px;
    margin: 1px 8px;
    border-radius: 6px;
    color: @MUTED@;
}
QTreeWidget#NavTree::item:hover { background: @SIDEBAR_HOVER@; color: @TEXT@; }
QTreeWidget#NavTree::item:selected {
    background: @SELECTION@;
    color: @TEXT@;
    font-weight: 600;
}
QTreeWidget#NavTree::branch { background: transparent; }
QTabWidget::pane {
    border: 1px solid @BORDER@;
    border-radius: 8px;
    background: @CARD@;
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: @MUTED@;
    padding: 8px 16px;
    border: 1px solid transparent;
    border-bottom: 2px solid transparent;
    margin-right: 3px;
}
QTabBar::tab:hover { color: @TEXT@; }
QTabBar::tab:selected {
    color: @TEXT@;
    border-bottom-color: @ACCENT@;
    font-weight: 600;
}
QProgressBar {
    background: @INPUT@;
    border: 1px solid @BORDER@;
    border-radius: 5px;
    text-align: center;
    color: @MUTED@;
    max-height: 12px;
}
QProgressBar::chunk { background: @ACCENT@; border-radius: 4px; }
QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: @BORDER_STRONG@;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: @MUTED@; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent;
    height: 11px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: @BORDER_STRONG@;
    border-radius: 5px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background: @MUTED@; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QSplitter::handle { background: @BORDER@; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }
QStatusBar {
    background: @PANEL@;
    border-top: 1px solid @BORDER@;
    color: @MUTED@;
    font-size: 9pt;
}
QStatusBar::item { border: none; }
QMenu {
    background: @CARD@;
    border: 1px solid @BORDER_STRONG@;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item { padding: 6px 20px; border-radius: 4px; }
QMenu::item:selected { background: @SELECTION@; }
QMenu::separator { height: 1px; background: @BORDER@; margin: 4px 8px; }
QToolBar { background: transparent; border: none; spacing: 6px; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget { background: transparent; }
QListWidget#SessionList, QListWidget#ProfileList {
    background: @CARD@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    padding: 4px;
}
QListWidget#SessionList::item, QListWidget#ProfileList::item {
    padding: 8px;
    border-radius: 5px;
}
QListWidget#SessionList::item:selected, QListWidget#ProfileList::item:selected {
    background: @SELECTION@;
}
