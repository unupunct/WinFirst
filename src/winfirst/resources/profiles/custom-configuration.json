    "disable_app_launch_tracking": true
  },
  "software": [],
  "checklist": [
    {"key": "backup_confirmed", "title": "Back up important files before applying changes", "required": true},
    {"key": "profile_reviewed", "title": "Review every setting before applying", "required": true},
    {"key": "profile_applied", "title": "Apply and verify the profile", "required": true},
    {"key": "updates_checked", "title": "Windows Update has been checked", "required": true}
  ]
